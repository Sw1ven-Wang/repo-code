# Build context must be examples/sandbox, never the project or user's home.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
COPY requirements.validation.txt /opt/repo-code/requirements.txt
RUN python -m pip install --no-cache-dir -r /opt/repo-code/requirements.txt \
    && python -m pip freeze > /opt/repo-code/installed.txt
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONNOUSERSITE=1 PYTEST_DISABLE_PLUGIN_AUTOLOAD=1
WORKDIR /workspace
USER 65534:65534
